# Canonical origin — drives metadata, canonical links, Open Graph, JSON-LD,
# sitemap.xml and robots.txt. On a Vercel production deploy this is optional:
# the build falls back to VERCEL_PROJECT_PRODUCTION_URL (your custom domain once
# one is attached). Setting it explicitly to the custom domain is still the
# safest choice — it pins one hostname (www or apex) as canonical.
#
# Until this resolves to a real domain, robots.txt serves `Disallow: /` so a
# preview or local build can never be indexed.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where /resume redirects to. Optional — next.config.js carries the current
# Google Drive link as its default. Set this to repoint the resume without a
# code change (a new Drive upload, an S3 object, a PDF in /public).
# NEXT_PUBLIC_RESUME_URL=https://drive.google.com/file/d/.../view

# Search-engine ownership via the HTML meta-tag method. Optional — DNS
# verification (a TXT record on the domain) needs neither. Paste only the
# token, not the whole <meta> tag. Read at build time; redeploy after setting.
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=

# ---------------------------------------------------------------------------
# CONTACT FORM
#
# Set ONE of the two below. With neither set, the form degrades honestly: the
# button reads "Compose email" and hands the message to the visitor's mail
# client, telling them it is not sent until they send it there.
#
# NOTE: both are NEXT_PUBLIC_ and therefore inlined at BUILD time, and
# next.config.js reads them at build time to widen the CSP. Setting either one
# requires a rebuild/redeploy — on Vercel, add it under
# Project Settings > Environment Variables and redeploy.
# ---------------------------------------------------------------------------

# 1. Web3Forms (current setup). Enter your email at https://web3forms.com and
#    the access key arrives by return mail — no account, no dashboard. The key
#    is public by design: it names the destination inbox and cannot be used to
#    read anything.
# NEXT_PUBLIC_WEB3FORMS_KEY=00000000-0000-0000-0000-000000000000

# 2. Or any backend taking a JSON POST of { name, email, subject, message } —
#    Formspree, Basin, Getform, or an API route of your own. Takes precedence
#    over the Web3Forms key above.
# NEXT_PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
